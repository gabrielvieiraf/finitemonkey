5;148mMath\u001b[38;5;231m.\u001b[38;5;148mmax\u001b[38;5;231m(\u001b[38;5;141m0\u001b[38;5;231m, sub - discount);                                              \r\u001b[5C\u001b[1B\u001b[38;5;77m 10 +\u001b[38;5;231m}                                                                                  \r\u001b[15C\u001b[2B\u001b[49m\u001b[38;5;246m11s \u00b7 \u2193\u001b[39m \u001b[38;5;246m530 t\u001b[30Gken\u001b[34G \u00b7 thought for\u001b[49G1s)\u001b[39m\u001b[K\u001b[32;1H\u001b[29;3H\u001b[?25h"]
