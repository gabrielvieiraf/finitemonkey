  "gate": {
    "required": {
      "schema": "string",
      "task": "string",
      "implicit": "boolean",
      "goal": "string",
      "treeHash": "string",
      "base": "string",
      "source": "string",
      "contractEdited": "boolean",
      "verdict": "string",
      "counts": "object",
      "items": "array",
      "decisionsNeeded": "array",
