{
  "envelope": {
    "required": {
      "schemaVersion": "number",
      "ok": "boolean",
      "command": "string"
    },
    "optional": {
      "data": "any",
      "error": "object",
      "next": "string"
    }
  },
  "error": {
    "required": {
      "code": "string",
      "message": "string",
      "fix": "string"
    }
  },
  "doctor": {
    "required": {
      "schema": "string",
      "checks": "array",
      "summary": "object"
    },
    "schema": "finitemonkey/doctor@1"
  },
  "doctorItem": {
    "required": {
      "check": "string",
      "status": "string",
      "detail": "string"
    },
    "optional": {
      "fix": "string"
    },
    "statuses": ["ok", "warn", "fail"]
  },
  "doctorSummary": {
    "required": {
      "ok": "number",
      "warn": "number",
      "fail": "number"
    }
  },
  "version": {
    "required": {
      "version": "string",
      "node": "string",
      "platform": "string"
    }
  },
  "help": {
    "required": {
      "commands": "array",
      "flags": "array",
      "exitCodes": "array"
    }
  },
  "helpCommand": {
    "required": {
      "name": "string",
      "usage": "string",
      "summary": "string",
      "status": "string",
      "options": "array"
    }
  },
  "i18nCheck": {
    "required": {
      "languages": "array",
      "keys": "number",
      "problems": "array",
      "source": "string"
    }
  },
  "exitCodes": {
    "Ok": 0,
    "CheckFailed": 1,
    "Usage": 2,
    "NotConfigured": 3,
    "NeedsPerson": 4,
    "Internal": 5
  },
  "secretsScan": {
    "required": {
      "schema": "string",
      "mode": "string",
      "baseline": "string",
      "findings": "array",
      "fixed": "array",
      "incidents": "array",
      "summary": "object"
    },
    "schema": "finitemonkey/secrets-scan@1"
  },
  "secretsFinding": {
    "required": {
      "id": "string",
      "rule": "string",
      "severity": "string",
      "file": "string",
      "line": "number",
      "column": "number",
      "fingerprint": "string",
      "mask": "string",
      "status": "string"
    },
    "optional": {
      "commit": "string"
    }
  },
  "secretsIncidents": {
    "required": {
      "schema": "string",
      "incidents": "array"
    },
    "schema": "finitemonkey/secrets-incidents@1"
  },
  "errorCodes": [
    "doctor_failed",
    "hook_blocked",
    "i18n_catalog_unreadable",
    "i18n_mismatch",
    "internal_error",
    "invalid_arguments",
    "invalid_lang",
    "needs_confirmation",
    "not_implemented",
    "unexpected_argument",
    "unknown_command",
    "unknown_hook_event",
    "secrets_found",
    "secrets_git_unavailable",
    "secrets_baseline_invalid",
    "secrets_finding_not_found",
    "secrets_incident_not_found",
    "secrets_not_rotated",
    "secrets_write_failed",
    "settings_unreadable",
    "lock_unreadable",
    "install_locked",
    "install_failed",
    "not_installed",
    "install_outdated"
  ]
}
