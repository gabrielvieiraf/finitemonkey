  "errorCodes": [
    "doctor_failed",
    "hook_blocked",
    "i18n_catalog_unreadable",
    "i18n_mismatch",
    "internal_error",
    "invalid_arguments",
    "invalid_lang",
    "needs_confirmation",
    "not_implemented",
    "unexpected_argument",
    "unknown_command",
    "unknown_hook_event",
    "secrets_found",
    "secrets_git_unavailable",
    "secrets_baseline_invalid",
    "secrets_finding_not_found",
    "secrets_incident_not_found",
    "secrets_not_rotated",
    "secrets_write_failed",
    "settings_unreadable",
    "lock_unreadable",
    "install_locked",
    "install_failed",
    "not_installed",
    "install_outdated",
    "gate_failed",
    "gate_incomplete",
    "gate_not_run",
    "not_a_git_repo",
    "task_exists",
    "task_invalid",
    "task_not_found",
    "prose_found",
    "prose_no_input",
    "prose_unreadable"
