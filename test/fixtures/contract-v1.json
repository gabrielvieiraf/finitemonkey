    "optional": {
      "commit": "string"
    }
  },
  "secretsIncidents": {
    "required": {
      "schema": "string",
      "incidents": "array"
    },
    "schema": "finitemonkey/secrets-incidents@1"
  },
  "proseCheck": {
    "required": {
      "schema": "string",
      "files": "array",
      "summary": "object"
    },
    "schema": "finitemonkey/prose-check@1"
  },
  "proseFile": {
    "required": {
      "file": "string",
      "allowed": "boolean",
      "spans": "array"
