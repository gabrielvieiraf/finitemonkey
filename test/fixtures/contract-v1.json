    "optional": {
      "reason": "string",
      "command": "string",
      "durationMs": "number",
      "releasedBy": "string",
      "at": "string"
    },
    "statuses": ["passed", "failed", "unverified"]
  },
  "evidence": {
    "required": {
      "schema": "string",
      "task": "string",
      "check": "string",
      "kind": "string",
      "status": "string",
      "treeHash": "string",
      "at": "string",
      "notes": "array"
    },
    "optional": {
      "command": "string",
      "stdoutSha256": "string",
      "durationMs": "number",
      "reason": "string",
      "releasedBy": "string",
      "failures": "array",
      "testCount": "number"
    },
    "schema": "finitemonkey/evidence@1"
  },
  "taskNew": {
    "required": {
      "schema": "string",
      "file": "string",
      "active": "boolean",
      "contract": "object"
    },
    "schema": "finitemonkey/task@1"
  }
}
