  "errorCodes": [
    "doctor_failed",
    "hook_blocked",
    "i18n_catalog_unreadable",
    "i18n_mismatch",
    "internal_error",
    "invalid_arguments",
    "invalid_lang",
    "not_implemented",
    "unexpected_argument",
    "unknown_command",
    "unknown_hook_event"
