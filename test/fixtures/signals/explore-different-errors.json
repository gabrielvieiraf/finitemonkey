{
  "expect": "quiet",
  "description": "Each failure is a different problem while the feature moves forward.",
  "events": [
    {
      "event": "UserPromptSubmit",
      "payload": {
        "prompt": "Add a CSV export to the report page"
      }
    },
    {
      "event": "PostToolUse",
      "payload": {
        "tool_name": "Edit",
        "tool_input": {
          "file_path": "src/report.ts",
          "old_string": "export {}",
          "new_string": "export const toCsv = () => ''"
        },
        "tool_response": {
          "success": true
        }
      }
    },
    {
      "event": "PostToolUseFailure",
      "payload": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "npm run build"
        },
        "error": "src/report.ts(1,30): error TS2307: Cannot find module 'papaparse'."
      }
    },
    {
      "event": "PostToolUse",
      "payload": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "npm i papaparse"
        },
        "tool_response": {
          "stdout": "ok",
          "stderr": "",
          "exitCode": 0
        }
      }
    },
    {
      "event": "PostToolUseFailure",
      "payload": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "npm run build"
        },
        "error": "src/report.tsx(8,3): error TS2322: Type 'number' is not assignable to type 'string'."
      }
    },
    {
      "event": "PostToolUse",
      "payload": {
        "tool_name": "Edit",
        "tool_input": {
          "file_path": "src/report.tsx",
          "old_string": "count",
          "new_string": "String(count)"
        },
        "tool_response": {
          "success": true
        }
      }
    },
    {
      "event": "PostToolUseFailure",
      "payload": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "npm run lint"
        },
        "error": "src/report.tsx:12:5  error  'unused' is defined but never used  no-unused-vars"
      }
    },
    {
      "event": "PostToolUse",
      "payload": {
        "tool_name": "Edit",
        "tool_input": {
          "file_path": "src/report.tsx",
          "old_string": "const unused = 1;",
          "new_string": ""
        },
        "tool_response": {
          "success": true
        }
      }
    },
    {
      "event": "PostToolUse",
      "payload": {
        "tool_name": "Bash",
        "tool_input": {
          "command": "npm test"
        },
        "tool_response": {
          "stdout": "ok",
          "stderr": "",
          "exitCode": 0
        }
      }
    },
    {
      "event": "UserPromptSubmit",
      "payload": {
        "prompt": "Now add a download button"
      }
    }
  ]
}
