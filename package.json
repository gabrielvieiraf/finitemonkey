{
  "name": "finitemonkey",
  "version": "0.1.0-next.20",
  "description": "Claude Code hooks that stop a coding agent from saying done before the tests pass: a machine-checked definition of done, plus guardrails for secrets, git safety and production. Pre-release.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Gabriel Vieira",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gabrielvieiraf/finitemonkey.git"
  },
  "homepage": "https://github.com/gabrielvieiraf/finitemonkey#readme",
  "bugs": {
    "url": "https://github.com/gabrielvieiraf/finitemonkey/issues"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "claude-code-hooks",
    "hooks",
    "definition-of-done",
    "ai-agent",
    "coding-agent",
    "guardrails",
    "secrets",
    "git-safety",
    "tests",
    "verification"
  ],
  "bin": {
    "finitemonkey": "dist/finitemonkey.mjs",
    "fm": "dist/finitemonkey.mjs"
  },
  "files": [
    "dist",
    "runbooks",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/test.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "i18n:check": "node dist/finitemonkey.mjs i18n check --dir src/i18n",
    "bench:startup": "node scripts/bench-startup.mjs",
    "smoke:install": "node scripts/smoke-install.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run check:dist && npm test && npm run i18n:check && npm run plugin:validate && npm pack --dry-run && npm run llms:check && npm run schema:check && npm run docs:check && npm run runbooks:check",
    "prepublishOnly": "npm run typecheck && npm run check:dist && npm test",
    "prepare": "husky",
    "gif": "tsc -p assets/scripts && node --experimental-strip-types assets/scripts/render.ts",
    "social": "tsc -p assets/scripts && node --experimental-strip-types assets/scripts/social.ts",
    "llms": "tsx scripts/build-llms.ts",
    "llms:check": "tsc -p scripts && tsx scripts/build-llms.ts --check",
    "llms:stamp": "tsx scripts/build-llms.ts --stamp",
    "schema": "tsx scripts/build-schemas.ts",
    "schema:check": "tsx scripts/build-schemas.ts --check",
    "budgets": "tsx scripts/budgets.ts",
    "docs": "tsx scripts/build-docs.ts",
    "docs:check": "tsc -p scripts && tsx scripts/build-docs.ts --check",
    "runbooks:check": "tsx scripts/check-runbooks.ts",
    "e2e:claude": "node --import tsx --test --test-concurrency=1 test/e2e/claude-stop.e2e.ts",
    "plugin:sync": "node scripts/plugin-sync.mjs",
    "plugin:validate": "node scripts/plugin-validate.mjs",
    "version": "node scripts/plugin-sync.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^20.19.43",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
