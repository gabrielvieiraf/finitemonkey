{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes --prefer-offline finitemonkey@0.1.0-next.1 hook SessionStart --via plugin",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes --prefer-offline finitemonkey@0.1.0-next.1 hook UserPromptSubmit --via plugin",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes --prefer-offline finitemonkey@0.1.0-next.1 hook PreToolUse --via plugin",
