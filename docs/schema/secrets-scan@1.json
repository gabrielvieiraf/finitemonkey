{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gabrielvieiraf/finitemonkey/blob/main/docs/schema/secrets-scan@1.json",
  "title": "finitemonkey/secrets-scan@1",
  "description": "`data` of `finitemonkey secrets scan --json`. Generated from SecretsScanData in src/commands/secrets-scan.ts by scripts/build-schemas.ts. Within a version, fields are only added.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "finitemonkey/secrets-scan@1"
    },
    "mode": {
      "type": "string",
      "enum": [
        "path",
        "staged",
        "history"
      ]
    },
    "baseline": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "number"
          },
          "column": {
            "type": "number"
          },
          "fingerprint": {
            "type": "string"
          },
          "mask": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "known",
              "expired"
            ]
          },
          "commit": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "rule",
          "severity",
          "file",
          "line",
          "column",
          "fingerprint",
          "mask",
          "status"
        ]
      }
    },
    "fixed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "incidents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total": {
          "type": "number"
        },
        "new": {
          "type": "number"
        },
        "known": {
          "type": "number"
        },
        "expired": {
          "type": "number"
        },
        "fixed": {
          "type": "number"
        }
      },
      "required": [
        "total",
        "new",
        "known",
        "expired",
        "fixed"
      ]
    }
  },
  "required": [
    "schema",
    "mode",
    "baseline",
    "findings",
    "fixed",
    "incidents",
    "summary"
  ]
}
