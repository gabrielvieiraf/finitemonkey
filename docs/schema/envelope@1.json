{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gabrielvieiraf/finitemonkey/blob/main/docs/schema/envelope@1.json",
  "title": "finitemonkey/envelope@1",
  "description": "Every `--json` output: the envelope around the command data. Generated from Envelope in src/core/result.ts by scripts/build-schemas.ts. Within a version, fields are only added.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "ok": {
      "type": "boolean"
    },
    "command": {
      "type": "string"
    },
    "data": {},
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "doctor_failed",
            "hook_blocked",
            "i18n_catalog_unreadable",
            "i18n_mismatch",
            "internal_error",
            "invalid_arguments",
            "invalid_lang",
            "needs_confirmation",
            "not_implemented",
            "unexpected_argument",
            "unknown_command",
            "unknown_hook_event",
            "secrets_found",
            "secrets_git_unavailable",
            "secrets_baseline_invalid",
            "secrets_finding_not_found",
            "secrets_incident_not_found",
            "secrets_not_rotated",
            "secrets_write_failed",
            "secrets_live_unreachable",
            "settings_unreadable",
            "lock_unreadable",
            "install_locked",
            "install_failed",
            "install_permission_denied",
            "not_installed",
            "install_outdated",
            "gate_failed",
            "gate_incomplete",
            "gate_not_run",
            "not_a_git_repo",
            "task_exists",
            "task_invalid",
            "task_not_found",
            "prose_found",
            "prose_no_input",
            "prose_unreadable",
            "git_snapshot_failed",
            "git_nothing_to_undo",
            "git_undo_failed",
            "git_rescue_failed",
            "merge_lost_work",
            "merge_unanalyzable",
            "app_check_failed",
            "githook_failed",
            "ci_gate_failed",
            "look_failed",
            "look_unavailable",
            "critique_must_fix",
            "plan_write_failed",
            "findings_not_found"
          ]
        },
        "message": {
          "type": "string"
        },
        "fix": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "fix"
      ]
    },
    "next": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "ok",
    "command"
  ]
}
