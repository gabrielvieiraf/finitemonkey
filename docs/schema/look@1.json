{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gabrielvieiraf/finitemonkey/blob/main/docs/schema/look@1.json",
  "title": "finitemonkey/look@1",
  "description": "`data` of `finitemonkey look --json`. Generated from LookData in src/commands/look.ts by scripts/build-schemas.ts. Within a version, fields are only added.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "finitemonkey/look@1"
    },
    "treeHash": {
      "type": "string"
    },
    "failures": {
      "type": "number"
    },
    "notes": {
      "type": "number"
    },
    "captures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contactSheet": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string"
        }
      ]
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule": {
            "type": "string",
            "enum": [
              "look/overflow",
              "look/console-error",
              "look/request-failed",
              "look/i18n-key",
              "look/broken-image",
              "look/touch-target",
              "look/banned-copy",
              "look/drift",
              "look/repeated-layout",
              "a11y/contrast",
              "a11y/non-text-contrast",
              "a11y/target-size",
              "a11y/reflow",
              "a11y/clipped-text",
              "a11y/name",
              "a11y/label",
              "a11y/alt",
              "a11y/landmark",
              "a11y/engine",
              "keyboard/unreachable",
              "keyboard/trap",
              "keyboard/focus-invisible",
              "keyboard/focus-obscured",
              "keyboard/order",
              "keyboard/dialog",
              "ui-states/not-covered",
              "ui-states/loading",
              "ui-states/empty",
              "ui-states/error-text",
              "ui-states/error-action",
              "ui-states/error-color",
              "ui-states/partial",
              "ui-states/status",
              "ui/dont"
            ]
          },
          "route": {
            "type": "string"
          },
          "viewport": {
            "type": "number"
          },
          "detail": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean"
          }
        },
        "required": [
          "rule",
          "route",
          "viewport",
          "detail",
          "blocking"
        ]
      }
    }
  },
  "required": [
    "schema",
    "treeHash",
    "failures",
    "notes",
    "captures",
    "contactSheet",
    "summary",
    "findings"
  ]
}
