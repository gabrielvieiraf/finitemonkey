{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gabrielvieiraf/finitemonkey/blob/main/docs/schema/doctor@1.json",
  "title": "finitemonkey/doctor@1",
  "description": "`data` of `finitemonkey doctor --json`. Generated from DoctorData in src/commands/doctor.ts by scripts/build-schemas.ts. Within a version, fields are only added.",
  "type": "object",
  "properties": {
    "fixed": {
      "type": "object",
      "properties": {
        "installed": {
          "type": "boolean"
        },
        "written": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "backup": {
          "type": "string"
        }
      },
      "required": [
        "installed",
        "written"
      ]
    },
    "reportPath": {
      "type": "string"
    },
    "hookInventory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "matcher": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "command": {
            "type": "string"
          },
          "ours": {
            "type": "boolean"
          },
          "enabled": {
            "type": "boolean"
          },
          "failMode": {
            "type": "string",
            "enum": [
              "fail-closed",
              "fail-open"
            ]
          },
          "latencyMs": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "number"
              }
            ]
          },
          "outputBytes": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "number"
              }
            ]
          },
          "blocksStop": {
            "type": "boolean"
          }
        },
        "required": [
          "source",
          "owner",
          "event",
          "matcher",
          "command",
          "ours",
          "enabled",
          "failMode",
          "latencyMs",
          "outputBytes",
          "blocksStop"
        ]
      }
    },
    "probe": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "seen": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cached": {
          "type": "boolean"
        }
      },
      "required": [
        "version",
        "at",
        "seen",
        "missing",
        "cached"
      ]
    },
    "schema": {
      "const": "finitemonkey/doctor@1"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "warn",
              "fail"
            ]
          },
          "detail": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        },
        "required": [
          "check",
          "status",
          "detail"
        ]
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded",
              "broken"
            ]
          },
          "fix": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "check",
          "status",
          "fix"
        ]
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "number"
        },
        "warn": {
          "type": "number"
        },
        "fail": {
          "type": "number"
        }
      },
      "required": [
        "ok",
        "warn",
        "fail"
      ]
    }
  },
  "required": [
    "schema",
    "checks",
    "hooks",
    "summary"
  ]
}
