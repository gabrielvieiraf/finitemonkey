    },
    "question": {
      "kind": "answer",
      "reply": "Done means: {{acceptance}}"
    },
    "blocked": {
      "kind": "answer",
      "reply": "Done means: {{acceptance}}"
    },
    "other": {
      "kind": "end"
    }
  }
